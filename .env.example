# Copy this file to .env and fill in your own values.
# Never commit .env!

# Job-alerts Gmail (IMAP with an app password)
JOB_EMAIL_ADDRESS=
JOB_EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com

# Optional: your name, removed from email text before it is sent to the AI.
# Comma-separated variants, e.g. "First Last, First"
MY_NAME=

# AI provider (any OpenAI-compatible API, via the openai package)
# Example for Groq: AI_BASE_URL=https://api.groq.com/openai/v1
# The model must support strict JSON schema output, e.g. openai/gpt-oss-120b
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional: only for reasoning models, e.g. "low" for the gpt-oss models
AI_REASONING_EFFORT=

# Telegram digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: the judge profile as text. Used instead of profile.txt when set
# (on GitHub Actions it comes from a secret).
PROFILE_TEXT=

# Key that encrypts the database for the GitHub Actions cache (Fernet key).
# Only needed locally for --encrypt-db / --decrypt-db.
DB_ENCRYPTION_KEY=
