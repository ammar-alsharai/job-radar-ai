# Copy this file to .env and fill in your own values.
# Never commit .env!

# Job-alerts Gmail (IMAP with an app password)
JOB_EMAIL_ADDRESS=
JOB_EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com

# AI provider (Groq, via the openai package with a custom base URL)
GROQ_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Telegram digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
